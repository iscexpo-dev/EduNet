# Application
NODE_ENV=development
# The web app talks to the gateway, not individual services.
NEXT_PUBLIC_API_URL=http://localhost:8080
GATEWAY_PORT=8080
# Number of trusted proxy hops in front of the gateway (set 1 behind TLS proxy).
TRUST_PROXY=0
# Comma-separated web origins allowed by CORS; empty = same origin only.
CORS_ORIGINS=http://localhost:3000
ENABLE_HSTS=false
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=20
GATEWAY_AI_RATE_LIMIT_PER_MINUTE=30

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edunet
DB_USER=postgres
DB_PASSWORD=your_password_here
# DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/edunet

# JWT Secret (required; replace before any non-local run)
JWT_SECRET=replace-with-at-least-32-random-characters

# Gateway upstream overrides (defaults are http://127.0.0.1:<service port>)
# IDENTITY_URL=http://localhost:3001
# COURSES_URL=http://localhost:3004
# AI_URL=http://localhost:3018

# Private media storage
MEDIA_STORAGE_PATH=./.data/media
# MEDIA_SIGNING_SECRET=replace-with-a-random-secret

# AI (AI fails closed when no provider is configured)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_TOKEN_LIMIT=50000
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUIRE_CONSENT=true
AI_COST_IN_MICROS_PER_TOKEN=1
AI_COST_OUT_MICROS_PER_TOKEN=3
AI_COUNSELOR_URL=

# Features
ENABLE_OFFLINE=true
ENABLE_BIOMETRIC=true
ENABLE_AI=true
