# Application
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# The web app talks to the gateway, not individual services.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Set to "standalone" only when building the container image.
# NEXT_OUTPUT=standalone
GATEWAY_PORT=8080
# Number of trusted proxy hops in front of the gateway (set 1 behind TLS proxy).
TRUST_PROXY=0
# Comma-separated web origins allowed by CORS; empty = same origin only.
CORS_ORIGINS=http://localhost:3000
ENABLE_HSTS=false
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=20
GATEWAY_AI_RATE_LIMIT_PER_MINUTE=30
# memory = in-process counters, valid for exactly one gateway replica.
# postgres = shared counters required when GATEWAY_REPLICA_COUNT > 1.
GATEWAY_RATE_LIMIT_STORE=memory
GATEWAY_REPLICA_COUNT=1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edunet
DB_USER=postgres
DB_PASSWORD=your_password_here
# DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/edunet
# Production requires TLS. Set DATABASE_SSL=true or use sslmode=require.
DATABASE_SSL=false
# Explicitly allow a non-TLS/loopback database in production. Document the
# exception; never enable this for a managed production database.
DATABASE_ALLOW_INSECURE=false

# JWT Secret (required; replace before any non-local run)
JWT_SECRET=replace-with-at-least-32-random-characters
BCRYPT_COST=10
# Production must use a real email/SMS provider. Tokens are never returned in
# production, even when this is not true.
DELIVER_EMAILS=false

# Gateway upstream overrides (defaults are http://127.0.0.1:<service port>)
# IDENTITY_URL=http://localhost:3001
# COURSES_URL=http://localhost:3004
# AI_URL=http://localhost:3018

# Private media storage
MEDIA_STORAGE_PATH=./.data/media
# Use a secret independent of JWT_SECRET in production.
# MEDIA_SIGNING_SECRET=replace-with-a-random-secret

# AI (AI fails closed when no provider is configured)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_TOKEN_LIMIT=50000
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUIRE_CONSENT=true
AI_COST_IN_MICROS_PER_TOKEN=1
AI_COST_OUT_MICROS_PER_TOKEN=3
AI_COUNSELOR_URL=

# Features
ENABLE_OFFLINE=true
ENABLE_BIOMETRIC=true
ENABLE_AI=true
