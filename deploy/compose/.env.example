# Copy to deploy/compose/.env for the LOCAL compose stack only.
# Never commit the resulting .env file.
POSTGRES_PASSWORD=replace-with-a-local-only-password
JWT_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Optional
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
