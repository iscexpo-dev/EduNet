{
  "name": "edunet",
  "version": "0.0.1",
  "private": true,
  "description": "EduNet - Production-grade, modular, secure, scalable education platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @edunet/database migrate",
    "db:generate": "pnpm --filter @edunet/database migrate:generate",
    "backup": "./scripts/backup-db.sh",
    "restore": "./scripts/restore-db.sh",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
