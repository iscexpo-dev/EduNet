{
  "name": "edunet",
  "version": "0.0.1",
  "private": true,
  "description": "EduNet - Production-grade, modular, secure, scalable education platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @edunet/database migrate",
    "db:generate": "pnpm --filter @edunet/database migrate:generate",
    "backup": "./scripts/backup-db.sh",
    "restore": "./scripts/restore-db.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:check": "pnpm --filter @edunet/database migrate:check",
    "format:check": "prettier --check 'docs/deployment/**/*.md' 'docs/pilot/**/*.md' 'deploy/**/*.{yml,yaml,md,json}' 'scripts/perf/*.mjs' 'scripts/smoke-test.mjs'",
    "ops:test": "./scripts/test-operations.sh",
    "perf:baseline": "node scripts/perf/baseline.mjs",
    "smoke:staging": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^8.57.0",
    "next": "^16.4.3",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "minimatch@>=9.0.0 <9.0.8": "^9.0.9",
      "postcss@<8.5.18": "^8.5.31",
      "body-parser@<1.20.9": "^1.20.9"
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
